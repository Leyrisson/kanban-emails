# Kanban de E-mails — credenciais
#
# Copie para credenciais.env e preencha. O arquivo real fica em
# ~/.config/kanban-emails/credenciais.env (modo 600) e NÃO vai para o Git.
#
# O app também sabe ler as credenciais do LeitorMail (IMAP) e do telebot
# (Telegram), em ~/.config/omarchy-voice/plugins/*/credenciais.env. Se você já
# tem os dois rodando, este arquivo pode ficar só com o que for diferente.

# --- IMAP (Gmail precisa de senha de app, não da senha da conta) ---
GMAIL_ADDR=voce@gmail.com
GMAIL_PASS=xxxx xxxx xxxx xxxx

# --- Telegram (mesmo bot do telebot, se você já tiver um) ---
# Fale com o @BotFather para criar o bot e obter o token.
TELEGRAM_BOT_TOKEN=
# Mande /start no seu bot e leia o chat_id em:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# --- Ajustes opcionais ---
# Host/porta do quadro (o padrão é 127.0.0.1:5055)
# KANBAN_HOST=127.0.0.1
# KANBAN_PORT=5055
# Tamanho do lote de e-mails por requisição IMAP
# KANBAN_JANELA=100
